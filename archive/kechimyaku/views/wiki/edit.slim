/ Wiki Edit Page with modern shadcn/ui styling
div class="min-h-screen bg-background"
  / Header section
  section class="py-16 bg-background"
    div class="container mx-auto px-6"
      div class="max-w-7xl mx-auto"
        div class="flex items-center justify-between space-y-2 mb-8"
          div
            h2 class="text-2xl font-bold tracking-tight" Editing Wiki: #{@master_name}
            p class="text-muted-foreground" Edit the wiki content for this master
          div class="flex items-center space-x-2"
            - if authenticated?
              span class="text-sm text-green-600" ✓ #{current_user}
              a class="text-sm text-red-600 hover:text-red-700" href="/logout" Logout
            - else
              span class="text-sm text-red-600" ✗ Not authenticated
              a class="text-sm text-blue-600 hover:text-blue-700" href="/login" Login
            a class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2" href="/wiki/view/#{@master_name.gsub(' ', '_')}" View Page

  / Main content section
  section class="py-8 bg-background"
    div class="container mx-auto px-6"
      div class="max-w-7xl mx-auto"
        / Authentication Status
        - if authenticated?
          div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-md"
            div class="flex items-center"
              svg class="w-5 h-5 text-green-600 mr-2" fill="currentColor" viewBox="0 0 20 20"
                path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"
              span class="text-green-800 font-medium" Authenticated as #{current_user}
              span class="text-sm text-green-600 ml-2" Changes will be saved locally
        - else
          div class="mb-6 p-4 bg-yellow-50 border border-yellow-200 rounded-md"
            div class="flex items-center"
              svg class="w-5 h-5 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20"
                path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"
              span class="text-yellow-800" 
                | Please 
                a class="text-yellow-900 underline" href="/login" login
                |  to edit wiki content.

        / Edit Form
        form method="post" action="/wiki/edit/#{@master_name.gsub(' ', '_')}" class="space-y-6"
          / Content Editor
          div
            label class="block text-sm font-medium text-gray-700 mb-2" for="content" Wiki Content
            textarea class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent" id="content" name="content" rows="20" placeholder="Enter wiki content in Markdown format..." #{@content}
          
          / Help text
          div class="text-sm text-muted-foreground"
            | Use Markdown syntax for formatting:
            ul class="list-disc list-inside space-y-1 mt-2"
              li
                span class="font-mono" Heading (use #)
                |  for headings
              li
                span class="font-mono" Bold (use double underscores or double asterisks)
                |  for bold text
              li
                span class="font-mono" Italic (use single underscores or single asterisks)
                |  for italic text
              li
                span class="font-mono" [Link](url)
                |  for links
              li
                span class="font-mono" &gt; Blockquote
                |  for blockquotes
              li
                span class="font-mono" - List item
                |  for lists

          / Commit Message
          div
            label class="block text-sm font-medium text-gray-700 mb-2" for="commit_message" Commit Message
            input type="text" id="commit_message" name="commit_message" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent" placeholder="Describe your changes..." value="Update wiki for #{@master_name}"

          / Action Buttons
          div class="flex items-center justify-between"
            div class="flex items-center space-x-4"
              button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-red-600 text-white hover:bg-red-700 h-10 px-4 py-2" Save Changes
              a class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2" href="/wiki/view/#{@master_name.gsub(' ', '_')}" Cancel

        / History Section
        - if @history && @history.any?
          div class="mt-12"
            h3 class="text-lg font-semibold mb-4" Edit History
            div class="space-y-3"
              - @history.each do |version|
                div class="flex items-center justify-between p-3 bg-gray-50 rounded-md"
                  div
                    p class="text-sm font-medium" #{version.message}
                    p class="text-xs text-gray-500" #{version.authored_date.strftime('%B %d, %Y at %I:%M %p')} by #{version.author.name}
                  div class="text-xs text-gray-400" Version #{version.id} 