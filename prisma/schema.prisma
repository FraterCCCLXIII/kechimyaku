// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Master {
  id           Int            @id @default(autoincrement())
  name         String?
  nameNative   String?        @map("name_native")
  overview     String?
  yearBorn     Int?           @map("year_born")
  yearDied     Int?           @map("year_died")
  dateBorn     String?        @map("date_born")
  dateDied     String?        @map("date_died")
  gender       String?
  location     String?
  isRoot       Boolean?       @map("is_root")
  wikiEntry    WikiEntry?
  childLinks   Relationship[] @relation("ParentRelationships")
  parentLinks  Relationship[] @relation("ChildRelationships")

  @@map("masters")
  @@index([name])
  @@index([isRoot])
}

model RelationshipType {
  id            Int            @id @default(autoincrement())
  name          String?
  relationships Relationship[]

  @@map("relationship_types")
}

model Relationship {
  id                 Int               @id @default(autoincrement())
  parentMasterId     Int               @map("parent_master_id")
  childMasterId      Int               @map("child_master_id")
  relationshipTypeId Int?              @map("relationship_type_id")
  parentMaster       Master            @relation("ParentRelationships", fields: [parentMasterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  childMaster        Master            @relation("ChildRelationships", fields: [childMasterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relationshipType   RelationshipType? @relation(fields: [relationshipTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("relationships")
  @@unique([parentMasterId, childMasterId, relationshipTypeId], name: "relationship_unique_triplet")
  @@index([parentMasterId])
  @@index([childMasterId])
}

model WikiEntry {
  id        Int      @id @default(autoincrement())
  masterId  Int      @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  master    Master   @relation(fields: [masterId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("wiki_entries")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String?  @unique
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  role         String   @default("member")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invitationsSent     Invitation[]         @relation("InvitedBy")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Invitation {
  id          Int       @id @default(autoincrement())
  email       String
  role        String    @default("member")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  invitedById Int?      @map("invited_by_id")
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")

  @@map("invitations")
  @@index([email])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  @@map("password_reset_tokens")
  @@index([userId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
